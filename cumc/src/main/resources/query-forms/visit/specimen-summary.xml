<row>
  <subForm>
    <name>specimenSummary</name>
    <caption>Specimen Summary</caption>
    <udn>specimen_summary</udn>
    <table>specimen_summary</table>
    <primaryKey>IDENTIFIER</primaryKey>
    <foreignKey>VISIT_ID</foreignKey>
    <parentKey>IDENTIFIER</parentKey>

    <row>
      <numberField>
        <name>specSummaryId</name>
        <udn>specSummaryId</udn>
        <caption>Specimen Summary ID</caption>
	<column>IDENTIFIER</column>
      </numberField>
    </row>

    <row>
      <textField>
        <name>specimenType</name>
        <udn>specimen_type</udn>
        <caption>Specimen Type</caption>
        <column>SPECIMEN_TYPE</column>
      </textField>
    </row>

    <row>
      <numberField>
        <name>specimenCount</name>
        <udn>specimen_count</udn>
        <caption>Specimen Count</caption>
        <column>SPECIMEN_COUNT</column>
      </numberField>
    </row>

    <row>
      <numberField>
        <name>collectionAge</name>
        <udn>collection_age</udn>
        <caption>Age at Collection</caption>
        <column>COLLECTION_AGE</column>
      </numberField>
    </row>

    <row>
      <datePicker>
        <name>collectionDate</name>
        <udn>collection_date</udn>
        <caption>Collection Date</caption>
        <column>COLLECTION_DATE</column>
      </datePicker>
    </row>

    <row>
      <numberField>
        <name>availableQuantity</name>
        <udn>available_quantity</udn>
        <caption>Available Quantity</caption>
        <column>AVAILABLE_QUANTITY</column>
      </numberField>
    </row> 

    <row>
      <textField>
        <name>unit</name>
        <udn>unit</udn>
        <caption>Unit</caption>
        <column>UNIT</column>
      </textField>
    </row>

    <row>
      <listBox>
        <name>diagnosisList</name>
        <udn>diagnosis_list</udn>
        <caption>Diagnosis</caption>
        <table>diagnosis_summary</table>
        <parentKey>IDENTIFIER</parentKey>
        <foreignKey>SPEC_SUMMARY_ID</foreignKey>
        <column>CLINICAL_DIAGNOSIS</column>
        <options>
          <sql>select distinct CLINICAL_DIAGNOSIS from diagnosis_summary</sql>
        </options>
        <multiSelect>true</multiSelect>
      </listBox>
    </row>   

    <row>
      <listBox>
        <name>sequencingTypeResults</name>
        <udn>sequencing_type_results</udn>
        <caption>Sequencing Type And Results</caption>
        <table>seq_type_results_summary</table>
        <parentKey>IDENTIFIER</parentKey>
        <foreignKey>SPEC_SUMMARY_ID</foreignKey>
        <column>SEQUENCING_TYPE_AND_RESULTS</column>
        <options>
          <sql>select distinct SEQUENCING_TYPE_AND_RESULTS from seq_type_results_summary</sql>
        </options>
        <multiSelect>true</multiSelect>
      </listBox>
    </row>

    <row>
      <listBox>
        <name>tissueSiteList</name>
        <udn>tissue_site_list</udn>
        <caption>Tissue Site</caption>
        <table>tissue_site_summary</table>
        <parentKey>IDENTIFIER</parentKey>
        <foreignKey>SPEC_SUMMARY_ID</foreignKey>
        <column>TISSUE_SITE</column>
        <options>
          <sql>select distinct TISSUE_SITE from tissue_site_summary</sql>
        </options>
        <multiSelect>true</multiSelect>
      </listBox>
    </row>

  </subForm>
</row>
