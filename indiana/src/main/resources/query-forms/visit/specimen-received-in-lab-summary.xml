<row>
  <subForm>
    <name>receive_in_lab_summary</name>
    <caption>Received In Lab Summary</caption>
    <udn>receive_in_lab_summary</udn>
    <table>receive_in_lab_summary</table>
    <primaryKey>IDENTIFIER</primaryKey>
    <foreignKey>VISIT_ID</foreignKey>

    <row>
      <textField>
        <name>spRecvType</name>
        <udn>spRecvType</udn>
        <caption>Type</caption>
        <column>SPECIMEN_TYPE</column>
      </textField>
    </row>

    <row>
      <numberField>
        <name>alqRecvCount</name>
        <udn>alqRecvCount</udn>
        <caption>Count</caption>
        <column>COUNT_OF_ALIQUOTS</column>
      </numberField>
    </row>

    <row>
      <numberField>
        <name>spRecvQty</name>
        <udn>spRecvQty</udn>
        <caption>Quantity</caption>
        <column>SPECIMEN_QUANTITY</column>
      </numberField>
    </row>

   <row>
      <textField>
        <name>collRecvCont</name>
        <udn>collRecvCont</udn>
        <caption>Collection Container</caption>
        <column>COLLECTION_CONTAINER</column>
      </textField>
    </row>


   <row>
      <textField>
        <name>spRecvLng</name>
        <udn>spRecvLng</udn>
        <caption>Lineage</caption>
        <column>LINEAGE</column>
      </textField>
    </row>
    
    <row>
      <textField>
        <name>spAvailSts</name>
        <udn>spAvailSts</udn>
	<caption>Availability Status</caption>
        <column>AVAILABILITY_STATUS</column>
      </textField>
    </row>

    <row>
      <textField>
        <name>custReasonDestroyed</name>
        <udn>custReasonDestroyed</udn>
	<caption>Reason Destroyed</caption>
        <column>REASON_DESTROYED</column>
      </textField>
    </row>

    <row>
  <datePicker>
    <name>receivedInLabDate</name>
    <udn>receivedInLabDate</udn>
    <caption>Received In Lab</caption>
    <format>MM-dd-yyyy/dateOnly</format>
    <column>RECEIVE_IN_LAB_TIME</column>
  </datePicker>
</row>

   <row>
      <textField>
        <name>specimenStoredOrNot</name>
        <udn>specimenStoredOrNot</udn>
        <caption>Stored?</caption>
        <column>STORED_STATUS</column>
      </textField>
    </row>
 </subForm>
</row>
